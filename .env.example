# Kopieren nach apps/api/.env bzw. als Umgebungsvariablen setzen.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://taxiads:PASSWORT@db.example.eu:5432/taxiads
# Öffentliche Adressen (HTTPS!)
PUBLIC_API_URL=https://api.taxiads.at
WEB_URL=https://portal.taxiads.at
CORS_ORIGINS=https://portal.taxiads.at
# Mindestens 32 zufällige Zeichen, z. B.: openssl rand -base64 48
APP_SECRET=
# Medien: S3-kompatibler Speicher in der EU
STORAGE_DRIVER=s3
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=eu-central
S3_BUCKET=taxiads-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# E-Mail-Versand (Registrierung, Passwort, Einladungen)
SMTP_URL=smtps://user:passwort@smtp.example.at:465
MAIL_FROM=TaxiAds <no-reply@taxiads.at>
# Zielauflösung Galaxy Tab A9+ (Querformat)
MEDIA_TARGET_WIDTH=1920
MEDIA_TARGET_HEIGHT=1200
