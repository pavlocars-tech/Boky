# Nur für die lokale Docker-Umgebung – NICHT in Produktion verwenden.
NODE_ENV=development
DATABASE_URL=postgres://taxiads:taxiads@db:5432/taxiads
PUBLIC_API_URL=http://localhost:3000
WEB_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001
APP_SECRET=dev-secret-change-me-dev-secret-change-me
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_CREATE_BUCKET=true
S3_REGION=eu-central-1
S3_BUCKET=taxiads-media
S3_ACCESS_KEY_ID=taxiads
S3_SECRET_ACCESS_KEY=taxiads-minio-secret
S3_FORCE_PATH_STYLE=true
